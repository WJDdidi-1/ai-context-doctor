{
  "name": "dsh-aiignore",
  "version": "0.2.1",
  "description": "Tells the agent which workspace files waste context, right when a session opens the repo.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "ai-context-doctor": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WJDdidi-1/ai-context-doctor.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/WJDdidi-1/ai-context-doctor#readme",
  "bugs": {
    "url": "https://github.com/WJDdidi-1/ai-context-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "ai-context-doctor",
    "context"
  ]
}
