  "title": {
    "en": "AI Context Doctor",
    "zh-cn": "AI 上下文医生"
  },
  "description": {
    "en": "A plugin index for AI Context Doctor, which warns you when a repository would flood your agent's context.",
    "zh-cn": "AI Context Doctor 的插件索引：当仓库会淹没智能体上下文时给出提醒。"
  },
